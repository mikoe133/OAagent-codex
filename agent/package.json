{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OA agent backend service.",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "tsx src/runtime/cli.ts",
    "dev:server": "tsx src/runtime/server.ts",
    "build": "tsc",
    "start": "node dist/runtime/cli.js",
    "start:server": "node dist/runtime/server.js",
    "sync:project-progress": "tsx src/runtime/projectProgressSync.ts --dry-run",
    "sync:project-progress:test-write": "tsx src/runtime/projectProgressSync.ts --apply-test",
    "start:project-progress": "node dist/runtime/projectProgressSync.js --dry-run",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.142.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
