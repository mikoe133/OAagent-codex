{
  "name": "oa-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal OA agent demo: Codex SDK + OpenRouter GLM 5.2 + openapi.json",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:server": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.142.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.18",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
