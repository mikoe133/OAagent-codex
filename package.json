{
  "name": "oa-agent-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the OA agent backend and frontend app.",
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "agent",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w agent --",
    "dev:agent": "npm run dev -w agent --",
    "dev:server": "npm run dev:server -w agent",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "build:agent": "npm run build -w agent",
    "build:frontend": "npm run build -w frontend --if-present",
    "start": "npm run start -w agent --",
    "start:server": "npm run start:server -w agent",
    "sync:project-progress": "npm run sync:project-progress -w agent --",
    "sync:project-progress:test-write": "npm run sync:project-progress:test-write -w agent --",
    "test:deploy": "node --test scripts/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "styled-components": "^6.4.3"
  }
}
