# --- Nexttoken (必填) ---
# 模型调用凭证。只用于 Codex SDK 调用模型,不允许写入 prompt、日志或最终回答。
NEXTTOKEN_API_KEY=

# Nexttoken OpenAI-compatible API 地址(可填根地址,程序会自动补 /v1)。
NEXTTOKEN_API_BASE_URL=https://next-token.cc

# --- OpenRouter (必填) ---
OPENROUTER_API_KEY=

# OpenRouter OpenAI-compatible API 地址。
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# --- 模型 ---
# Codex SDK CLI 默认 provider 与模型。Web 端可在 nexttoken/openrouter 之间切换。
CODEX_MODEL_PROVIDER=nexttoken
CODEX_MODEL=gpt-5.6-terra
# 可选。原生运行留空,由程序选择 read-only/workspace-write。
# 仅当进程已运行在独立外部沙箱中时才使用 danger-full-access。
CODEX_SANDBOX_MODE=

# --- OA 后端 ---
# OA OpenAPI 文档地址。默认优先读取该地址;请求失败、非 2xx 或内容不是合法
# OpenAPI JSON 时,自动回退到 agent/openapi/openapi.json。
OA_OPENAPI_URL=https://api-oa.rwkvos.com/openapi_json

# Web 路由守卫和 agent 都会用当前用户 OA token 调用 OA 验证接口。
# OA token 只在服务端注入,不会传给 prompt。
OA_API_BASE_URL=
# 自动任务系统迁移到 Node 后，前端 BFF 和 OAagent Worker 的 claim/heartbeat/result/audit
# 调用该地址；未配置时兼容回退到 OA_API_BASE_URL 或 OA_DOCKER_API_BASE_URL。
AUTOMATION_API_BASE_URL=
# OAagent Worker 读取项目、GitHub URL、写 Commit 总结和项目状态仍调用旧 OA。
PROJECT_SYNC_API_BASE_URL=
# 受控 OA 工具默认按 Cookie: sessionid=<token> 调用 OA。
OA_API_TOKEN_HEADER=Cookie
OA_API_TOKEN_PREFIX=sessionid=
# OA 数据源 alias。
OA_AUTH_ALIAS=default

# --- GitHub 项目进度 Worker ---
# OA 后台服务身份；生产环境应使用可轮换的最小权限服务 token，不得长期复用用户 session token。
OA_PROJECT_SYNC_TOKEN=
OA_PROJECT_SYNC_TOKEN_HEADER=Authorization
OA_PROJECT_SYNC_TOKEN_PREFIX=Bearer
PROJECT_PROGRESS_GITHUB_TOKEN=
PROJECT_PROGRESS_WRITE_ENABLED=false
# 仅本地 OA 服务连接测试库时使用；开启写入必须精确填写该确认值。
PROJECT_PROGRESS_UNSAFE_TEST_WRITES=
# 全项目真实写入必须精确填写 I_UNDERSTAND_PRODUCTION_WRITES；与测试确认变量不能同时启用。
PROJECT_PROGRESS_PRODUCTION_WRITES=
# 默认 .context/project-progress.sqlite。
PROJECT_PROGRESS_STATE_DB=
# 可选；默认复用 Nexttoken 地址、NEXTTOKEN_API_KEY 和 gpt-5.6-terra。
PROJECT_PROGRESS_MODEL_API_BASE_URL=
PROJECT_PROGRESS_MODEL_API_KEY=
PROJECT_PROGRESS_MODEL_PROVIDER=nexttoken
PROJECT_PROGRESS_MODEL=gpt-5.6-terra
PROJECT_PROGRESS_MODEL_REASONING_EFFORT=medium
PROJECT_PROGRESS_MODEL_MAX_OUTPUT_TOKENS=1024
# Codex Agent 按需读取单 Commit 详情的硬预算。GitHub token 不会传入 Agent 子进程。
PROJECT_PROGRESS_AGENT_MAX_DETAIL_CALLS=12
PROJECT_PROGRESS_AGENT_MAX_FILES_PER_COMMIT=20
PROJECT_PROGRESS_AGENT_MAX_PATCH_CHARS_PER_FILE=1200
PROJECT_PROGRESS_AGENT_MAX_TOTAL_PATCH_CHARS=12000
# 单 Worker 内的三层并发：GitHub HTTP、仓库 Codex Thread、OA mutation。
PROJECT_PROGRESS_GITHUB_CONCURRENCY=6
# 单次运行和单仓库 GitHub 扫描硬上限；达到后仓库标记 incomplete，不生成部分总结。
PROJECT_PROGRESS_GITHUB_MAX_BRANCHES=500
PROJECT_PROGRESS_GITHUB_MAX_COMMIT_PAGES_PER_BRANCH=100
PROJECT_PROGRESS_GITHUB_MAX_REQUESTS_PER_REPOSITORY=2000
PROJECT_PROGRESS_GITHUB_MAX_REQUESTS_PER_RUN=20000
PROJECT_PROGRESS_AGENT_CONCURRENCY=2
PROJECT_PROGRESS_OA_WRITE_CONCURRENCY=1
# 默认 .context/project-progress-workspaces；每个仓库 Thread 使用独立临时目录。
PROJECT_PROGRESS_WORKSPACE_ROOT=

# OA 后端读取模型目录、校验自动化任务模型时使用。两端配置相同的独立高强度 token。
OA_AGENT_AUTOMATION_TOKEN=
# --- Node 自动任务存储 ---
# DATABASE_URL 必须由部署平台 Secret 注入；此处只保留空键，不填写完整连接串。
DATABASE_URL=
# 与原 OA HeaderSessionMiddleware 使用的签名密钥一致。
OA_SESSION_SECRET=
# 0 表示只验签、不额外限制签名年龄；正数表示最大秒数。
OA_SESSION_VERIFY_MAX_AGE=0
# 生产部署建议先单独执行 migrate:automation；单实例首次部署也可临时开启。
AUTOMATION_MIGRATE_ON_START=false
AUTOMATION_MAINTENANCE_ENABLED=true
AUTOMATION_MAINTENANCE_INTERVAL_SECONDS=30
AUTOMATION_MODEL_CATALOG_TTL_SECONDS=300
AUTOMATION_MODEL_CATALOG_STALE_SECONDS=86400
AUTOMATION_SCHEDULE_GRACE_SECONDS=120
AUTOMATION_MANUAL_TRIGGER_LIMIT=3
AUTOMATION_MANUAL_TRIGGER_WINDOW_SECONDS=300
# 同一 Worker 生命周期内保持稳定；默认使用 oaagent-<主机名>。
PROJECT_PROGRESS_WORKER_INSTANCE=
# 租约和心跳秒数；心跳必须小于租约。
PROJECT_PROGRESS_LEASE_SECONDS=300
PROJECT_PROGRESS_HEARTBEAT_SECONDS=10

# OA 与 OA Agent 之间的 SSO 签名密钥。两端必须一致,生产环境请使用高强度随机值。
OA_AGENT_SSO_SHARED_SECRET=
# SSO 凭证有效期(秒),必须是正整数。
OA_AGENT_SSO_TTL_SECONDS=300

# 前端请求 agent 接口时,从哪个 header 读取用户 OA token。
# 默认读取 Authorization: Bearer <token>,也会自动兼容 Cookie: sessionid=<token>。
OA_USER_TOKEN_HEADER=Authorization
OA_USER_TOKEN_PREFIX=Bearer

# 可选。默认启动时随机生成,只允许本机 Codex 子进程调用内部工具端点。
AGENT_OA_TOOL_TOKEN=

# --- 后台服务(可选) ---
# 默认只监听本机。所有 /v1/* 请求都必须携带并通过 OA 验证的用户 token。
HOST=127.0.0.1
PORT=3000

# --- Docker Compose(可选) ---
# 同一台服务器部署多套环境时必须不同,例如 oa-agent-prod / oa-agent-test。
COMPOSE_PROJECT_NAME=oa-agent
# agent/web 容器访问 OA 服务端的地址。OA 与本项目部署在同一台 Docker 主机时,
# 使用现有 OA Compose 发布的宿主机 8010 端口;不要填写 127.0.0.1。
OA_DOCKER_API_BASE_URL=http://host.docker.internal:8010
# 默认仅绑定宿主机 loopback。若同机 OA 后端运行在其他容器且不加入本 Compose 网络,
# 可改为宿主机 docker0 地址；测试/生产必须使用不同端口。
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_PORT=3001
# web 对宿主机的监听地址和端口。生产环境建议由 HTTPS 反向代理转发到该端口。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
# 可选镜像名,默认 oa-agent:local 与 oa-web:local。
AGENT_IMAGE=oa-agent:local
WEB_IMAGE=oa-web:local

# --- 前端 BFF -> agent 服务(可选) ---
# 当前端和 agent 不在同一端口时配置。不要和 OA_API_BASE_URL 混用。
AGENT_API_BASE_URL=http://127.0.0.1:3000

# sessionId -> Codex threadId 的持久化文件。默认 .context/agent-sessions.json。
AGENT_SESSION_STORE=

# --- OA 知识库 ---
# 知识库 Agent API 地址；默认使用接口文档中的生产地址。
OA_KNOWLEDGE_API_BASE_URL=https://oa-kb.rwkvos.com/api/agent/v1
# 仅用于服务端组装知识库 Authorization: Bearer header 的固定 Token，不得下发到浏览器或 Agent。
OA_KNOWLEDGE_BASE_API_KEY=
