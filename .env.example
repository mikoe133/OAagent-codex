# --- OpenRouter (必填) ---
# 模型调用凭证。只用于 Codex SDK 调用模型,不允许写入 prompt、日志或最终回答。
OPENROUTER_API_KEY=

# OpenRouter OpenAI-compatible API 地址(可选,默认 https://openrouter.ai/api/v1)。
# 兼容旧变量名 OPENROUTER_API_BASE_URL。
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- 模型 ---
# Codex SDK 使用的 provider 与模型。model slug 可选,默认 gpt-5.5。
# 兼容旧变量名 OPENROUTER_MODEL。
CODEX_MODEL_PROVIDER=openrouter
CODEX_MODEL=gpt-5.5

# --- OA 后端(可选) ---
# 配置后 agent 可通过受控 callOaApi 工具调用 agent/openapi/openapi.json 中声明的 OA 接口。
# OA token 只在服务端注入,不会传给 prompt。
OA_API_BASE_URL=
# OA 后端登录态。旧变量名 OA_SERVICE_SESSIONID 已统一为 OA_API_TOKEN。
# 可选 fallback。前端请求 header 中的用户 OA token 会优先于这里的服务级 token。
OA_API_TOKEN=
# 默认按 Authorization: Bearer <OA_API_TOKEN> 发送。
OA_API_TOKEN_HEADER=
OA_API_TOKEN_PREFIX=

# 前端请求 agent 接口时,从哪个 header 读取用户 OA token。
# 默认读取 Authorization: Bearer <token>,也会自动兼容 Cookie: sessionid=<token>。
# 如果同时启用 AGENT_API_TOKEN,Authorization 会被服务鉴权占用,
# 建议前端改用 X-OA-Api-Token,或让浏览器正常携带 Cookie。
OA_USER_TOKEN_HEADER=Authorization
OA_USER_TOKEN_PREFIX=Bearer

# 可选。默认启动时随机生成,只允许本机 Codex 子进程调用内部工具端点。
AGENT_OA_TOOL_TOKEN=

# --- 后台服务(可选) ---
# 默认只监听本机。若 HOST 配成 0.0.0.0 或其他非本机地址,必须配置 AGENT_API_TOKEN。
HOST=127.0.0.1
PORT=3000
AGENT_API_TOKEN=

# sessionId -> Codex threadId 的持久化文件。默认 .context/agent-sessions.json。
AGENT_SESSION_STORE=
